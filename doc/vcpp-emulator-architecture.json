  "cards": [
    {
      "dot": "cyan",
      "title": "协议栈",
      "items": [
        "已实现云快充 V1.5 / V1.6 / V1.7 全帧，V18 / V21 未实现",
        "帧结构 0x68 起始 + 长度 + 序列号 + 加密标志 + 帧类型 + CRC16",
        "版本差异由纯函数推导：ProtoVerByte / TradeFrameType / SupportsParallel"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行模型",
      "items": [
        "每桩一个 Actor goroutine 串行处理帧、定时器与 API 命令",
        "断线 10s 重连 · 每枪心跳 10s · 充电中 15s 上报",
        "交易记录 V15、V16 发 0x3B，V17 起发 0x3D，未确认则重传"
      ]
    },
    {
      "dot": "amber",
      "title": "精度与边界",
      "items": [
        "电量与金额用 int64 定点 ×0.0001，费率与单价 ×0.00001",
        "计费模型无模式字段，按帧长度识别：90B = 4 段，98B = 5 段",
        "数据仅内存与日志，进程重启不保留；OCPP 仅预留协议入口"
      ]
    }
  ]
